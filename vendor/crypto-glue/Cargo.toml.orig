[package]
name = "crypto-glue"
description = "A facade over the RustCrypto ecosystem"
version = "0.2.2"
edition = "2024"
license = "MPL-2.0"
homepage = "https://github.com/kanidm/crypto-glue/"
repository = "https://github.com/kanidm/crypto-glue/"
authors = ["William Brown <william@blackhats.net.au>"]

[features]
default = ["alloc"]
alloc = ["argon2/alloc"]

[dependencies]
aes = "0.9.2"
aes-gcm = "0.11.0"
aes-kw = "0.3.1"
argon2 = { version = "0.5.2", features = ["alloc"] }
base64 = { version = "^0.23.1" }
cbc = "0.2.1"
cipher = { version = "0.5", features = ["block-padding", "alloc"] }
const-oid = "0.10"
crypto-common = { version = "0.2.2", features = ["rand_core"] }
cts = "0.7.0"
der = "0.8.1"
digest = { version = "0.11.0", default-features = false, features = ["mac"] }
ecdsa = { version = "0.17", features = ["digest", "der", "pem"] }
elliptic-curve = { version = "0.14.1", features = ["arithmetic", "sec1"] }
hybrid-array = { version = "0.4", features = ["serde", "zeroize"] }
hex = "0.4.3"
hkdf = "0.13"
hmac = "0.13.0"
kbkdf = { version = "0.1.0-rc.1" }
md5 = { version = "0.8.1" }
p256 = { version = "0.14", features = ["ecdh", "pem"] }
p384 = "0.14"
p521 = "0.14"
pbkdf2 = "0.13"
pkcs8 = { version = "0.11", features = ["encryption"] }
rand = "0.10"
rsa = { version = "0.10.0", features = ["pkcs1v15"] }
sec1 = "0.8.1"
spki = { version = "0.8", features = ["fingerprint"] }
serde = "^1.0.228"
signature = "3.0"
sha1 = "0.11"
sha2 = "0.11"
subtle = "^2.6.1"
tracing = "^0.1.37"
uuid = { version = "1", features = ["v4"] }
x509-cert = { version = "0.3", features = ["builder", "hazmat"] }
zeroize = { version = "1.6.0", features = ["serde"] }

[dev-dependencies]
tracing-subscriber = "^0.3.20"

[target.'cfg(windows)'.dev-dependencies]
# For UnixStream on Windows
# TODO: replace with stdlib when stable: https://github.com/rust-lang/rust/issues/150487
uds_windows = "1.2.1"

[target.'cfg(any(unix, windows))'.dev-dependencies]
# rustls is only used for tests on these platforms, because aws-lc-rs doesn't run on WASM32
rustls = { version = "0.23", default-features = false, features = ["aws-lc-rs", "std"] }

[target.'cfg(all(target_arch = "wasm32", any(target_os = "unknown", target_os = "none")))'.dev-dependencies]
# Per https://docs.rs/getrandom/latest/getrandom/#webassembly-support, we don't want to add
# dependencies for WASM+JS environments unconditionally to all WASM targets.
#
# However, we need these as dev-dependencies for the library's tests, which treats WASM as WASM+JS.
# If we start testing on other WASM environments, we'll need to revisit this.
#
# Sources of time and entropy in a WASM+JS environment, enabling features in transitive dependencies
# via feature unification. Binary users of this library will need something similar for their target
# platform.
getrandom = { version = "0.4.3", features = ["wasm_js"] }
rustls-pki-types = { version = "1.14.0", features = ["web"] }
uuid = { version = "1.20.0", features = ["js"] }

# wasm-bindgen and wasm-bindgen-test are only directly used by tests.
wasm-bindgen = { version = "0.2.121" }
wasm-bindgen-test = "0.3.0"

