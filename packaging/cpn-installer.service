[Unit]
Description=CPN Control Panel Network web installer
Documentation=https://github.com/Control-Panel-Network/CPN-Control-Panel-Network
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Default listen port is 2087. Override with --port, Environment=CPN_LISTEN_PORT=,
# or a preference saved under /var/lib/cpn/listen_port. Optional panel hostname
# and port migration preferences are stored under /var/lib/cpn. Bind is
# 127.0.0.1 unless --allow-remote is explicitly requested.
ExecStart=/usr/bin/cpn-installer
Restart=on-failure
RestartSec=3
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
