[Unit]
Description=CPN Control Panel Network web installer
Documentation=https://github.com/Control-Panel-Network/CPN-Control-Panel-Network
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Default listen port is 2087. Override with --port, Environment=CPN_LISTEN_PORT=, or
# a preference saved from the installer UI under /var/lib/cpn/listen_port.
# Bind is 127.0.0.1 unless --allow-remote / CPN_ALLOW_REMOTE=1.
ExecStart=/usr/bin/cpn-installer
Restart=on-failure
RestartSec=3
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
