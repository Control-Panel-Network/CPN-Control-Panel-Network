[Unit]
Description=CPN Control Panel Network web installer
Documentation=https://github.com/Control-Panel-Network/CPN-Control-Panel-Network
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Default listen port is 2087. Override with --port, Environment=CPN_LISTEN_PORT=, or
# a preference saved under /var/lib/cpn/listen_port. Optional panel hostname and
# port migration live in /var/lib/cpn/panel_hostname and port_migration (see
# to-do/PANEL-PORT-SUBDOMAIN.md). Bind is 127.0.0.1 unless --allow-remote.
ExecStart=/usr/bin/cpn-installer
Restart=on-failure
RestartSec=3
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
