{
  "name": "panel",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "npx --yes prettier@3.9.6 --write src scripts next.config.ts postcss.config.mjs eslint.config.mjs tsconfig.json",
    "format:check": "npx --yes prettier@3.9.6 --check src scripts next.config.ts postcss.config.mjs eslint.config.mjs tsconfig.json",
    "typecheck": "next typegen && tsc --noEmit",
    "auth-selftest": "node scripts/auth-selftest.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.65.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26.6.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10",
    "eslint-config-next": "16.4.5",
    "@typescript-eslint/parser": "^8.72.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "eslint": {
      "minimatch": "11.0.5"
    },
    "@eslint/config-array": {
      "minimatch": "11.0.5"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.5"
    },
    "zod": "^4.6.6"
  }
}
