{
  "name": "panel",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "npx --yes prettier@3.9.6 --write src scripts next.config.ts postcss.config.mjs eslint.config.mjs tsconfig.json",
    "format:check": "npx --yes prettier@3.9.6 --check src scripts next.config.ts postcss.config.mjs eslint.config.mjs tsconfig.json",
    "typecheck": "next typegen && tsc --noEmit",
    "auth-selftest": "node scripts/auth-selftest.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.31.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
