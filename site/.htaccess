Options -Indexes
DirectoryIndex index.php index.html

# Keep bootstrap scripts as scripts (not HTML) for curl / wget one-liners.
<IfModule mod_headers.c>
  <FilesMatch "^(install\.sh|upgrade\.sh|preUpgrade\.sh|cpn-bootstrap-lib\.sh)$">
    Header set Content-Type "text/plain; charset=utf-8"
    Header set Content-Disposition "inline"
    Header set X-Content-Type-Options nosniff
    Header set Cache-Control "no-cache, max-age=300"
  </FilesMatch>

  Header always set X-Content-Type-Options nosniff
  Header always set X-Frame-Options DENY
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

<Files "config.php">
  Order Allow,Deny
  Deny from all
</Files>
<Files "config.host-site.php">
  Order Allow,Deny
  Deny from all
</Files>
<FilesMatch "\.(log|sql|bak|backup|key|pem|env)$">
  Order Allow,Deny
  Deny from all
</FilesMatch>
<DirectoryMatch "(logs|tmp|private|modules/cli|data/cache)">
  Order Allow,Deny
  Deny from all
</DirectoryMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Redirect /index.html to /
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^ /? [R=301,L]

  # Redirect /page.html to /page (clean URLs; keep install/upgrade scripts as .sh)
  RewriteCond %{THE_REQUEST} \s/+([^.?\s]+)\.html[\s?] [NC]
  RewriteRule ^ /%1? [R=301,L]

  # Hide .php in public URLs (portal routes)
  RewriteCond %{THE_REQUEST} \s/+(.+)\.php[\s?] [NC]
  RewriteCond %{REQUEST_URI} !^/(install|upgrade|preUpgrade|cpn-bootstrap-lib)\.sh [NC]
  RewriteRule ^ /%1? [R=301,L]

  # Trailing slash cleanup (keep real files)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # Auth routes
  RewriteRule ^auth/discord/?$ auth/discord.php [L,QSA]
  RewriteRule ^auth/callback/?$ auth/callback.php [L,QSA]

  # Extensionless path -> matching .html when the file exists (disclosure /security)
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^([^\.]+)$ $1.html [L]

  # Never map clean /config to config.php (secrets stay denied)
  RewriteRule ^config/?$ - [F,L]

  # Extensionless PHP for portal pages when the file exists
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}.php -f
  RewriteRule ^([^\.]+)$ $1.php [L,QSA]
</IfModule>

# Optional LiteSpeed cache: leave commented for OLS/LSE portability
# <IfModule Litespeed>
#   CacheDisable public /
# </IfModule>