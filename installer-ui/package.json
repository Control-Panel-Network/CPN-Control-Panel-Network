{
  "name": "cpn-installer-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "smoke:github-issue": "tsx src/githubIssue.smoke.ts",
    "format": "npx --yes prettier@3.9.6 --write src vite.config.ts tsconfig.json",
    "format:check": "npx --yes prettier@3.9.6 --check src vite.config.ts tsconfig.json",
    "bundle": "vite build"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "lucide-react": "^1.45.0",
    "motion": "^13.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "simple-icons": "^16.30.0",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "autoprefixer": "^10.5.6",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.13",
    "typescript": "~5.8.2",
    "vite": "^8.3.0"
  }
}
